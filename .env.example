# Provider credentials (never commit real values)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Provider order and model names. Free-tier availability can change.
JARVIS_PROVIDER_ORDER=gemini,openrouter
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# Runtime limits
JARVIS_REQUEST_TIMEOUT_SECONDS=30
JARVIS_MAX_RETRIES_PER_PROVIDER=1
JARVIS_MAX_TOOL_ROUNDS=5
JARVIS_MAX_INPUT_CHARS=12000
JARVIS_LOG_LEVEL=INFO

# Local paths
JARVIS_AUDIT_LOG=logs/audit.jsonl
JARVIS_MEMORY_DB=memory/memory.db
# Windows paths separated by ;, for example:
# JARVIS_ALLOWED_ROOTS=C:\\Users\\YourName\\Desktop;C:\\Users\\YourName\\Documents;C:\\Users\\YourName\\Downloads

# Optional JSON allowlist. Only configured executable paths may be opened or closed.
# JARVIS_APP_ALLOWLIST={"notepad":{"executable":"C:\\Windows\\System32\\notepad.exe","arguments":[]}}
