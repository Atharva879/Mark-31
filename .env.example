# Provider credentials (never commit real values)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Provider order and model names. Free-tier availability can change.
# Valid providers: local, gemini, openrouter. The local provider is localhost-only.
JARVIS_PROVIDER_ORDER=gemini,openrouter
JARVIS_LOCAL_MODEL=llama3.2
JARVIS_LOCAL_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# Runtime limits
JARVIS_REQUEST_TIMEOUT_SECONDS=30
JARVIS_MAX_RETRIES_PER_PROVIDER=1
JARVIS_MAX_TOOL_ROUNDS=5
JARVIS_MAX_INPUT_CHARS=12000
JARVIS_LOG_LEVEL=INFO

# Local paths
JARVIS_AUDIT_LOG=logs/audit.jsonl
JARVIS_MEMORY_DB=memory/memory.db
JARVIS_VECTOR_DB=memory/memory.vectors.db
JARVIS_SCHEDULER_DB=memory/scheduler.db
JARVIS_PRESENCE_DB=memory/presence.db
JARVIS_CONVERSATION_DB=memory/conversations.db
JARVIS_CONVERSATION_MAX_TURN_CHARS=12000
JARVIS_CONTEXT_CLIPBOARD_MAX_CHARS=4000
JARVIS_NOTIFICATIONS_DB=memory/notifications.db
JARVIS_NOTIFICATION_MAX_HISTORY=500
JARVIS_NATIVE_NOTIFICATIONS=false
JARVIS_TRAY_ENABLED=false
# Windows paths separated by ;, for example:
# JARVIS_ALLOWED_ROOTS=C:\\Users\\YourName\\Desktop;C:\\Users\\YourName\\Documents;C:\\Users\\YourName\\Downloads

# Optional JSON allowlist. Only configured executable paths may be opened or closed.
# JARVIS_APP_ALLOWLIST={"notepad":{"executable":"C:\\Windows\\System32\\notepad.exe","arguments":[]}}

# Optional Discord bot integration. Messages are enabled only for these channel IDs.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=

# Optional WhatsApp Desktop UI automation. The tool is disabled unless enabled.
# Dry-run stays on by default and never sends a real message.
WHATSAPP_ENABLED=false
WHATSAPP_DRY_RUN=true

# Screen and camera awareness are opt-in from the desktop UI and auto-expire after this many seconds.
JARVIS_SCREEN_TIMEOUT_SECONDS=60
JARVIS_CAMERA_TIMEOUT_SECONDS=60
JARVIS_VISUAL_ANALYSIS_COOLDOWN_SECONDS=600

# Optional local voice controls. Audio capture is one bounded push-to-talk utterance.
JARVIS_WHISPER_MODEL=base
JARVIS_VOICE_MAX_SECONDS=10
JARVIS_TTS_RATE=175
JARVIS_WHISPER_DEVICE=cpu
JARVIS_WHISPER_COMPUTE_TYPE=int8

# Jarvis Presence. One-minute idle eligibility with generous anti-repetition limits.
# STAY SILENT in the desktop UI overrides all proactive output.
JARVIS_PRESENCE_IDLE_SECONDS=60
JARVIS_PRESENCE_COOLDOWN_SECONDS=600
JARVIS_PRESENCE_HOURLY_LIMIT=2
JARVIS_PRESENCE_DAILY_LIMIT=20

# Background monitoring and scheduled triggers. The app must remain open for jobs to run.
# Only bounded reminders, public web_url checks, and allowed-root file monitors are supported.
JARVIS_SCHEDULER_POLL_SECONDS=1
JARVIS_SCHEDULER_MAX_RUN_HISTORY=500

# Public web search and current-data retrieval limits.
JARVIS_WEB_TIMEOUT_SECONDS=15
JARVIS_WEB_MAX_RESULTS=5
JARVIS_WEB_MAX_RESPONSE_BYTES=1000000
# Optional comma-separated host allowlist for fetch_web_data; empty means public hosts are allowed.
JARVIS_WEB_ALLOWED_HOSTS=

# Local image and document analysis limits. Files must remain under JARVIS_ALLOWED_ROOTS.
JARVIS_MULTIMODAL_MAX_BYTES=12000000
JARVIS_DOCUMENT_MAX_CHARS=80000

# Agent tool-calling limits. Shell commands require user confirmation and never use shell=True.
JARVIS_SHELL_ALLOWLIST=echo,whoami,where,ipconfig,git
JARVIS_SHELL_TIMEOUT_SECONDS=15
JARVIS_SHELL_MAX_OUTPUT_CHARS=12000

# Advanced file and code-sandbox limits.
JARVIS_SANDBOX_TIMEOUT_SECONDS=5
JARVIS_SANDBOX_MAX_OUTPUT_CHARS=12000
JARVIS_SANDBOX_MAX_CODE_CHARS=8000
JARVIS_SANDBOX_MEMORY_LIMIT_MB=256

# Multi-agent delegation limits. Delegated roles cannot call sensitive tools or delegate recursively.
JARVIS_MAX_SUBTASKS=5
JARVIS_MAX_AGENT_WORKERS=3
JARVIS_AGENT_TIMEOUT_SECONDS=45
JARVIS_AGENT_MAX_PROMPT_CHARS=4000
JARVIS_AGENT_MAX_RESULT_CHARS=12000
